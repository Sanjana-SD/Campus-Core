# =================================================================
# CAMPUS CORE - ENVIRONMENT CONFIGURATION (copy to .env and fill in)
# Never commit .env or any credential file.
# =================================================================

PROJECT_NAME="Campus Core"
TAGLINE="One Campus. One Core. Everything Connected."
API_V1_STR="/api/v1"

# --- Security -------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------------
# Relative SQLite paths resolve against this project folder.
DATABASE_URL=sqlite:///./campuscore.db
# PostgreSQL example:
# DATABASE_URL=postgresql://campuscore:change-me@localhost:5432/campuscore
# Apply migrations automatically on startup (alembic upgrade head)
AUTO_MIGRATE=true

# --- Existing Google Form / RFID response spreadsheet ---------------
GOOGLE_SHEET_ID=1CLlTz9hZ3IdChuTO9gx4Fusf5CspohMhyqn3Pwar_xw
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1CLlTz9hZ3IdChuTO9gx4Fusf5CspohMhyqn3Pwar_xw/edit?gid=0#gid=0

# Read access (server-side only). Recommended: a Google Cloud service account.
#  1. Create a service account, enable the Google Sheets API for its project.
#  2. Download its JSON key to config/google-service-account.json (git-ignored).
#  3. Share the spreadsheet with the service account e-mail as Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=config/google-service-account.json
# Alternatively paste the JSON key content (single line) instead of a path:
# GOOGLE_SERVICE_ACCOUNT_INFO=
# Optional alternative reader: the existing Apps Script web app (?action=export)
# GOOGLE_APPS_SCRIPT_WEBAPP_URL=

# How ambiguous dates such as 03/04/2026 are read: DMY or MDY
SHEET_DATE_ORDER=DMY

# Shared secret for the optional Apps Script push webhook (empty = webhook disabled)
INTEGRATION_WEBHOOK_SECRET=replace-with-a-random-secret

# --- Initial attendance defaults (editable later in Admin > Attendance Policy)
COLLEGE_TIMEZONE=Asia/Kolkata
ATTENDANCE_THRESHOLD_PERCENT=75.0
LATE_ARRIVAL_GRACE_MINUTES=10

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
